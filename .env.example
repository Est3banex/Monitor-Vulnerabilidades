# Copia este archivo como .env y completa los valores. El .env NUNCA se sube a GitHub.
# Nota: en n8n las llaves viven en Credentials; este archivo es para el docker-compose
# y para el notebook / scripts locales.

# --- Red local ---
OLLAMA_URL=http://192.168.56.1:11434
